# --- Etsy Open API v3 ---
# Etsy Developer portalindan alinan keystring (x-api-key)
ETSY_API_KEY=
# OAuth2 access token. Sadece okuma icin sart degil, ama apply.js (yazma) icin zorunlu.
# Gerekli scope'lar: listings_r listings_w
ETSY_ACCESS_TOKEN=
# Magaza ID'niz (sayi). Bilmiyorsaniz: node scrape.js --whoami
ETSY_SHOP_ID=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Varsayilan model. Degistirmeniz gerekmiyor.
CLAUDE_MODEL=claude-opus-5

# --- Pinterest API v5 ---
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# --- Opsiyonel ---
# Verilerin yazilacagi klasor (varsayilan: ./data)
DATA_DIR=./data
# Baslik karakter siniri (tweet'teki kural: 70)
MAX_TITLE_LENGTH=70
# Aciklama minimum karakter sayisi
MIN_DESCRIPTION_LENGTH=1000

# --- Sadece test icin (uretimde bos birakin) ---
# ETSY_BASE_URL=
# PINTEREST_BASE_URL=
# ANTHROPIC_BASE_URL=
